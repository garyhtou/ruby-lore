---
layout: default
title: Glossary
lead: The words and phrases you'll hear thrown around the Ruby community, A to Z.
---

<%
  # Selection/sort shared with this page's .md counterpart via CardQueries
  # (see lib/card_queries.rb, which documents the A-to-Z sort that strips
  # leading punctuation from quoted-phrase terms) so the two can never
  # disagree on order.
  vocabulary_cards = CardQueries.vocabulary(collections.cards.resources)
%>

<h1><%= data.title %></h1>
<p class="lead"><%= data.lead %></p>

<dl class="glossary">
  <% vocabulary_cards.each do |card| %>
    <%
      hook = card.data.hook.to_s.strip
    %>
    <div class="glossary__entry">
      <dt class="glossary__term"><a href="<%= card.relative_url %>"><%= card.data.title %></a></dt>
      <% unless hook.empty? %>
        <dd class="glossary__definition"><%= hook %></dd>
      <% end %>
    </div>
  <% end %>
</dl>
