---
layout: default
title: Timeline
---

<%
  # Every card that carries a `dates:` front-matter entry (currently the
  # five "release"/dated stories: named-before-it-existed, ruby-1-0,
  # the-pickaxe, rails-from-basecamp, ruby-3-0), sorted ascending by the
  # card's EARLIEST date. A card could in principle carry more than one
  # `dates` entry, so we sort by the minimum rather than assuming the
  # first entry is chronologically first.
  dated_cards = collections.cards.resources
    .select { |card| card.data.dates.is_a?(Array) && card.data.dates.any? }
    .sort_by { |card| card.data.dates.map(&:date).min }
%>

<h1><%= data.title %></h1>
<p class="lead">The Ruby canon, in order. Every dated stop on the tour, oldest first.</p>

<ol class="timeline">
  <% dated_cards.each do |card| %>
    <%
      earliest = card.data.dates.min_by(&:date)
      hook = card.data.hook.to_s.strip
    %>
    <li class="timeline__entry">
      <time class="timeline__date" datetime="<%= earliest.date.iso8601 %>"><%= earliest.date.strftime("%B %-d, %Y") %></time>
      <a class="timeline__link" href="<%= card.relative_url %>"><%= card.data.title %></a>
      <% unless hook.empty? %>
        <p class="timeline__hook"><%= hook %></p>
      <% end %>
    </li>
  <% end %>
</ol>
