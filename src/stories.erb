---
layout: default
title: Stories
---

<%
  story_cards = collections.cards.resources
    .select { |card| card.data.type == "story" }
    .sort_by { |card| card.data.title.to_s.downcase }
%>

<h1><%= data.title %></h1>
<p class="lead">The moments and turning points that shaped Ruby's history.</p>

<ul class="card-listing">
  <% story_cards.each do |card| %>
    <%
      hook = card.data.hook.to_s.strip
    %>
    <li class="card-listing__entry">
      <a href="<%= card.relative_url %>"><%= card.data.title %></a>
      <% unless hook.empty? %>
        <p class="card-listing__hook"><%= hook %></p>
      <% end %>
    </li>
  <% end %>
</ul>
