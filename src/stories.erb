---
layout: default
title: Stories
lead: The moments and turning points that shaped Ruby's history.
---

<%
  # Selection/sort shared with this page's .md counterpart via CardQueries
  # (see lib/card_queries.rb) so the two can never disagree on order.
  story_cards = CardQueries.stories(collections.cards.resources)
%>

<h1><%= data.title %></h1>
<p class="lead"><%= data.lead %></p>

<ul class="card-listing">
  <% story_cards.each do |card| %>
    <%
      hook = card.data.hook.to_s.strip
    %>
    <li class="card-listing__entry">
      <a href="<%= card.relative_url %>"><%= card.data.title %></a>
      <% unless hook.empty? %>
        <p class="card-listing__hook"><%= hook %></p>
      <% end %>
    </li>
  <% end %>
</ul>
