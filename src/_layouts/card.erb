---
layout: default
---

<%
  # The rendered card body (Markdown -> HTML, with [[slug]] wiki-links
  # already resolved to real <a href> by plugins/wiki_links.rb). `.to_s`
  # just guarantees a plain String to work with below; we output it
  # unescaped further down via the raw-output ERB tag, regardless of its
  # safety flag.
  body_html = yield.to_s

  # Progressive disclosure: every card body ends in a Markdown "## Sources"
  # section (enforced by script/validate.rb), which Kramdown always
  # renders as `<h2 id="sources">Sources</h2>` followed by the citation
  # list, with nothing after it (verified across all 17 cards). Tuck that
  # section into a <details> so citations are present-but-collapsed by
  # default, while every source link still lives in the static DOM - a
  # <details> element renders its content in the accessibility tree and to
  # view-source regardless of the [open] state.
  sources_match = body_html.match(/(<h2 id="sources">.*)\z/m)
  if sources_match
    body_html = sources_match.pre_match +
      %(<details class="card__sources">\n<summary>Sources</summary>\n) +
      sources_match[1] +
      "\n</details>\n"
  end

  primary_source = data.sources.is_a?(Array) ? data.sources.first : nil
  hook = data.hook.to_s.strip

  # "Edit this page on GitHub" deep-link. resource.relative_path
  # is the card's source path relative to src/ (e.g. "_cards/people/matz.md"
  # - confirmed by inspecting a built page during development), so
  # prefixing with "src/" reconstructs the real repo path GitHub's web
  # editor expects: .../edit/main/src/_cards/<segment>/<slug>.md. Built
  # from site.metadata.repo_url (the same public-repo URL already used in
  # the footer and JSON-LD, src/_data/site_metadata.yml) rather than a
  # hardcoded host, so it stays correct if the repo ever moves.
  edit_url = "#{site.metadata.repo_url}/edit/main/src/#{resource.relative_path}"
%>

<article class="card" data-card-type="<%= data.type %>">
  <%= render "breadcrumbs" %>

  <%= render ExhibitCard.new(
        title: data.title,
        dates: data.dates,
        citation_text: primary_source && primary_source.title,
        citation_href: primary_source && primary_source.url
      ) %>

  <% unless hook.empty? %>
    <p class="lead"><%= hook %></p>
  <% end %>

  <div class="card__body">
    <%== body_html %>
  </div>

  <p class="card__edit">
    <a href="<%= edit_url %>">See a mistake? Edit this page on GitHub</a>
  </p>
</article>
