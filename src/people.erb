---
layout: default
title: People
lead: The people whose names get invoked over and over in Ruby's history.
---

<%
  # Selection/sort shared with this page's .md counterpart via CardQueries
  # (see lib/card_queries.rb) so the two can never disagree on order.
  people_cards = CardQueries.people(collections.cards.resources)
%>

<h1><%= data.title %></h1>
<p class="lead"><%= data.lead %></p>

<ul class="people">
  <% people_cards.each do |card| %>
    <%
      hook = card.data.hook.to_s.strip
    %>
    <li class="people__entry">
      <a href="<%= card.relative_url %>"><%= card.data.title %></a>
      <% unless hook.empty? %>
        <p class="people__hook"><%= hook %></p>
      <% end %>
    </li>
  <% end %>
</ul>
