---
layout: default
title: People
---

<%
  people_cards = collections.cards.resources
    .select { |card| card.data.type == "person" }
    .sort_by { |card| card.data.title.to_s.downcase }
%>

<h1><%= data.title %></h1>
<p class="lead">The people whose names get invoked over and over in Ruby's history.</p>

<ul class="people">
  <% people_cards.each do |card| %>
    <%
      hook = card.data.hook.to_s.strip
    %>
    <li class="people__entry">
      <a href="<%= card.relative_url %>"><%= card.data.title %></a>
      <% unless hook.empty? %>
        <p class="people__hook"><%= hook %></p>
      <% end %>
    </li>
  <% end %>
</ul>
