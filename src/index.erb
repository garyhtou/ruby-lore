---
layout: default
---

<%
  cards_by_slug = collections.cards.resources_by_slug

  # Both lists are shared with the home page's .md counterpart via
  # CardQueries (see lib/card_queries.rb) so the HTML and the Markdown can
  # never disagree on which cards appear or in what order:
  #   - timeline_preview: a curated handful of stops that sketch Ruby's
  #     whole arc (chosen for span, not recency), oldest first - not every
  #     dated card, which is what the full chronology at /timeline/ is for.
  #   - featured_cards: the editorial home-page pick, a curated set of entry
  #     points into the site (not the ordered tour.yml walk, and it can
  #     include cards the tour doesn't, such as tenderlove). Title/href come
  #     from the resolved card, never retyped.
  timeline_preview = CardQueries.home_timeline_preview(cards_by_slug)
  featured_cards = CardQueries.featured(cards_by_slug)
%>

<section class="hero">
  <h1 class="hero__title"><%= site.metadata.title %></h1>
  <p class="hero__tagline"><%= site.metadata.tagline %></p>
  <%# This intro prose is mirrored by MarkdownPagesRender::HOME_INTRO for the
      home page's .md counterpart (only the Start here link target differs:
      /start-here/ here vs /start-here.md there). Keep the two in sync if you
      edit this copy. %>
  <p class="hero__intro">
    A collection of the people, stories, talks, and words that make up Ruby's
    history, the kind of thing a longtime Rubyist would tell you over
    coffee. New here? <a href="<%= relative_url '/start-here/' %>">Start here</a>
    for a guided walk through it all.
  </p>
</section>

<section class="timeline-preview" aria-labelledby="timeline-preview-heading">
  <h2 id="timeline-preview-heading">The short version, in time</h2>
  <ol class="timeline-preview__list">
    <% timeline_preview.each do |card| %>
      <%
        earliest = card.data.dates.min_by(&:date)
        # See src/timeline.erb for why year-only-precision dates (e.g. "the
        # Pickaxe, around 2000") render just the year instead of a false-
        # precise full date. The <time datetime> stays a full ISO date.
        display_date = earliest.precision == "year" ? earliest.date.strftime("%Y") : earliest.date.strftime("%B %-d, %Y")
      %>
      <li class="timeline-preview__entry">
        <time datetime="<%= earliest.date.iso8601 %>"><%= display_date %></time>
        <a href="<%= card.relative_url %>"><%= card.data.title %></a>
      </li>
    <% end %>
  </ol>
  <p><a href="<%= relative_url '/timeline/' %>">See the full timeline &rarr;</a></p>
</section>

<%= render "flourish" %>

<section class="featured-cards" aria-labelledby="featured-cards-heading">
  <h2 id="featured-cards-heading">A few places to start</h2>
  <ul class="featured-cards__list">
    <% featured_cards.each do |card| %>
      <%
        hook = card.data.hook.to_s.strip
      %>
      <li class="featured-cards__entry">
        <a href="<%= card.relative_url %>"><%= card.data.title %></a>
        <% unless hook.empty? %>
          <p><%= hook %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>

<nav class="home-nav" aria-label="Browse Ruby Lore">
  <ul>
    <li><a href="<%= relative_url '/start-here/' %>">Start Here</a></li>
    <li><a href="<%= relative_url '/timeline/' %>">Timeline</a></li>
    <li><a href="<%= relative_url '/people/' %>">People</a></li>
    <li><a href="<%= relative_url '/glossary/' %>">Glossary</a></li>
  </ul>
</nav>
